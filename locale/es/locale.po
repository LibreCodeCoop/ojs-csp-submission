msgid "plugins.generic.CspSubmission.displayName"
msgstr "Sumisión CSP"

msgid "plugins.generic.CspSubmission.description"
msgstr "Personaliza el envío de acuerdo con el flujo de los Cadernos de Saúde Pública de la Fiocruz."

msgid "plugins.generic.CspSubmission.espacoTematico"
msgstr "Tema"

msgid "plugins.generic.CspSubmission.conflitoInteresse"
msgstr "¿Su artículo tiene un potencial conflicto de intereses?"

msgid "plugins.generic.CspSubmission.conflitoInteresseTexto"
msgstr "Describa el conflicto de intereses"

msgid "plugins.generic.CspSubmission.codigoFasciculoTematico"
msgstr "Código de emisión temática"

msgid "plugins.generic.CspSubmission.codigoFasciculoTematico.description"
msgstr "Rellena este campo si tu artículo pertenece a un volumen temático (solicita el código al editor invitado)"

msgid "plugins.generic.CspSubmission.agradecimentos"
msgstr "Gracias"

msgid "plugins.generic.CspSubmission.dataAvailabilityRadios.label"
msgstr "Disponibilidad de los datos"

msgid "plugins.generic.CspSubmission.dataAvailabilityRadios.dadosDisponiveisNoRepo"
msgstr "Las bases de datos utilizadas en el estudio, incluyendo los códigos de extracción, los análisis y los resultados, están disponibles en el repositorio a continuación."

msgid "plugins.generic.CspSubmission.dataAvailabilityRadios.dadosDisponiveisMedianteSolicitacao"
msgstr "Los datos de la investigación están disponibles previa solicitud al autor correspondiente."

msgid "plugins.generic.CspSubmission.dataAvailabilityRadios.fontesIndicadasNoCorpoDoArtigo"
msgstr "Las fuentes de información utilizadas en el estudio se indican en el cuerpo del artículo."

msgid "plugins.generic.CspSubmission.dataAvailabilityRadios.dadosNaoDisponiveis"
msgstr "Los datos de la investigación no están disponibles."

msgid "plugins.generic.CspSubmission.dataAvailabilityRadios.naoSeAplica"
msgstr "No aplicable."

msgid "plugins.generic.CspSubmission.codigoArtigoRelacionado"
msgstr "Código"

msgid "plugins.generic.CspSubmission.SectionFile.errorWordCount"
msgstr "La sección "{$section}" debe contener texto con un máximo de {$max} palabras. El archivo subido contiene {$count} palabras."

msgid "plugins.generic.CspSubmission.SectionFile.invalidFormat.AticleBody"
msgstr "¡Formato de archivo no válido! Formatos permitidos para este tipo de archivo: .doc, .docx ou .odt"

msgid "plugins.generic.CspSubmission.SectionFile.invalidFormat.Image"
msgstr "¡Formato de archivo no válido! Formatos permitidos para este tipo de archivo: .png, .jpeg, .bmp, .tiff, .xls, .xlsx o .ods"

msgid "plugins.generic.CspSubmission.keywords.Notification"
msgstr "Se requieren un mínimo de 3 y un máximo de 5 palabras clave"

msgid "plugins.generic.CspSubmission.authorBiography.Notification"
msgstr "Es necesario rellenar el campo \"Contribución del autor a la obra\" para todos los autores."

msgid "plugins.generic.CspSubmission.authorAddress.Notification"
msgstr "Los campos de dirección deben completarse para todos los autores."

msgid "plugins.generic.CspSubmission.submission.bodyTextFile.limit"
msgstr "Solo se permite un archivo de cuerpo de texto"

msgid "plugins.generic.CspSubmission.submission.transcriptsFile.limit"
msgstr "Sólo se permite un archivo de subtítulos"

msgid "plugins.generic.CspSubmission.consideracoesEticas"
msgstr "Consideraciones éticas y legales"

msgid "plugins.generic.CspSubmission.consideracoesEticas.checkbox.yes"
msgstr "En el caso de artículos que involucraran investigaciones con seres humanos, se cumplieron los principios contenidos en la Declaración de Helsinki, además de cumplir con la legislación específica del país en el que se realizó la investigación. En el caso de investigaciones con animales de fauna silvestre y/o cuyes, se cumplió con la legislación pertinente."

msgid "plugins.generic.CspSubmission.consideracoesEticas.checkbox.no"
msgstr "No aplicable (el estudio no implica investigación con humanos o animales)."

msgid "plugins.generic.CspSubmission.submission.newVersion.alert"
msgstr "Es obligatorio enviar una carta al editor asociado eligiendo el componente <b>Cambios realizados</b>"

msgid "plugins.generic.CspSubmission.submission.title.description"
msgstr "Límite mínimo 15, límite máximo 300 caracteres con espacios"

msgid "plugins.generic.CspSubmission.preprint"
msgstr "¿Su texto está almacenado en un servidor preprint?"

msgid "plugins.generic.CspSubmission.preprint.doi"
msgstr "Indique el DOI asignado al manuscrito si se ha depositado en un servidor de preprint:"

msgid "plugins.generic.CspSubmission.monografDissertTese.label"
msgstr "Monografía/Disertación/Tesis"

msgid "plugins.generic.CspSubmission.monografDissertTese.description"
msgstr "¿Su texto está disponible en un repositorio de Monografías/Disertaciones/Tesis?<br> "
"<input class='form-check-input' type='radio' name='monografDissertTese' value='Sim' id='monografDissertTeseSim'> Sí <br> "
"<input class='form-check-input' type='radio' name='monografDissertTese' value='Não' id='monografDissertTeseNao' checked> No <br> "
"Indique el enlace del repositorio:"