msgid "plugins.generic.CspSubmission.displayName"
msgstr "Submissão CSP"

msgid "plugins.generic.CspSubmission.description"
msgstr "Customiza a etapa de submissão de acordo como o fluxo do Cadernos de Saúde Pública da Fiocruz."

msgid "plugins.generic.CspSubmission.espacoTematico"
msgstr "Tema"

msgid "plugins.generic.CspSubmission.conflitoInteresse"
msgstr "Seu artigo possui potencial conflito de interesse?"

msgid "plugins.generic.CspSubmission.conflitoInteresseTexto"
msgstr "Descreva o conflito de interesse"

msgid "plugins.generic.CspSubmission.conflitoInteresse.Notification'"
msgstr "É necessário inserir o enderećo em todos os co-autores"

msgid "plugins.generic.CspSubmission.codigoFasciculoTematico"
msgstr "Código do fascículo temático"

msgid "plugins.generic.CspSubmission.codigoFasciculoTematico.description"
msgstr "Preencha este campo caso seu artigo pertença a um volume temático (solicite o código ao editor convidado)"

msgid "plugins.generic.CspSubmission.agradecimentos"
msgstr "Agradecimentos"

msgid "plugins.generic.CspSubmission.dataAvailabilityRadios.label"
msgstr "Disponibilidade de dados"

msgid "plugins.generic.CspSubmission.dataAvailabilityRadios.dadosDisponiveisNoRepo"
msgstr "Os bancos de dados utilizados no estudo, incluindo os códigos de extração, análises e resultados estão disponíveis em repositório no campo abaixo."

msgid "plugins.generic.CspSubmission.dataAvailabilityRadios.dadosDisponiveisMedianteSolicitacao"
msgstr "Os dados de pesquisa estão disponíveis mediante solicitação ao autor de correspondência."

msgid "plugins.generic.CspSubmission.dataAvailabilityRadios.fontesIndicadasNoCorpoDoArtigo"
msgstr "As fontes de informação utilizadas no estudo estão indicadas no corpo do artigo."

msgid "plugins.generic.CspSubmission.dataAvailabilityRadios.dadosNaoDisponiveis"
msgstr "Os dados de pesquisa não estão disponíveis."

msgid "plugins.generic.CspSubmission.dataAvailabilityRadios.naoSeAplica"
msgstr "Não se aplica."

msgid "plugins.generic.CspSubmission.codigoArtigoRelacionado"
msgstr "Código"

msgid "plugins.generic.CspSubmission.SectionFile.errorWordCount"
msgstr "A seção "{$section}" deve conter \"Corpo do texto\" com no máximo {$max} palavras. O arquivo enviado contém {$count} palavras."

msgid "plugins.generic.CspSubmission.SectionFile.errorWordCountParse"
msgstr "Não foi possível contar as palavras do arquivo \"{$genre}\". Por favor, limpe o arquivo removendo formatações complexas (como caixas de texto aninhadas) e envie novamente."

msgid "plugins.generic.CspSubmission.SectionFile.invalidFormat"
msgstr "Formato de arquivo inválido de \"{$genre}\"! Formatos permitidos para este tipo de arquivo: {$allowedFormats}"

msgid "plugins.generic.CspSubmission.keywords.Notification"
msgstr "São necessárias no mínimo 3 e no máximo 5 palavras-chave"

msgid "plugins.generic.CspSubmission.authorBiography.Notification"
msgstr "É necessário preencher o campo \"Contribuição do autor no trabalho\" para todos os autores"

msgid "plugins.generic.CspSubmission.authorAddress.Notification"
msgstr "É necessário preencher os campos de endereço para todos os autores"

msgid "plugins.generic.CspSubmission.submission.bodyTextFile.limit"
msgstr "Só é permitido inseir um arquivo \"Corpo do texto\""

msgid "plugins.generic.CspSubmission.submission.transcriptsFile.limit"
msgstr "Só é permitido inseir um arquivo de legendas"

msgid "plugins.generic.CspSubmission.consideracoesEticas"
msgstr "Considerações éticas e legais"

msgid "plugins.generic.CspSubmission.consideracoesEticas.Notification"
msgstr "É necessário preencher o campo Considerações éticas e legais"

msgid "plugins.generic.CspSubmission.consideracoesEticas.checkbox.yes"
msgstr "No caso de artigos que envolvem pesquisas com seres humanos, foram cumpridos os princípios contidos na Declaração de Helsinki, além de atendida a legislação específica do país no qual a pesquisa foi realizada. No caso de pesquisa envolvendo animais da fauna silvestre e/ou cobaias foram atendidas as legislações pertinentes."

msgid "plugins.generic.CspSubmission.consideracoesEticas.checkbox.no"
msgstr "Não se aplica (estudo não envolve pesquisa com seres humanos ou animais)."

msgid "plugins.generic.CspSubmission.submission.newVersion.alert"
msgstr "É obrigatória a submissão de uma carta ao editor associado escolhendo o componente <b>Alterações realizadas</b>"

msgid "plugins.generic.CspSubmission.submission.title.description"
msgstr "Limite mínimo 15, limite máximo 300 caracteres com espaços"

msgid "plugins.generic.CspSubmission.preprint"
msgstr "Seu texto está depositado em servidor preprint?"

msgid "plugins.generic.CspSubmission.preprint.doi"
msgstr "Informe o DOI atribuído ao manuscrito caso tenha sido depositado em servidor preprint:"

msgid "plugins.generic.CspSubmission.monografDissertTese.options"
msgstr "Seu texto está disponibilizado em repositório de Monografia/Dissertação/Tese?"

msgid "plugins.generic.CspSubmission.monografDissertTese.repo"
msgstr "Informe o link do repositório:"

msgid "plugins.generic.CspSubmission.usoIA.options"
msgstr "Uso de IA na elaboração do manuscrito?"

msgid "plugins.generic.CspSubmission.usoIA.description"
msgstr "Em caso afirmativo, especifique e detalhe a utilização:"

msgid "plugins.generic.CspSubmission.usoIA.Notification"
msgstr "É obrigatório informar se houve uso de Inteligência Artificial no trabalho."
